# MindLoom Optional Environment Overrides (All values are local paths; never commit real secrets)

# Override default Obsidian Vault directory (default: ~/Documents/Obsidian/MindLoom)
# MINDLOOM_VAULT=

# Override default isolated Data directory (default: ~/Documents/Obsidian/MindLoom-Data)
# MINDLOOM_DATA=

# Override default config file location (default: ~/.mindloom/config.json)
# MINDLOOM_CONFIG=

# Override Operator isolation root (default: C:\ProgramData\MindLoom on Windows, ~/.mindloom-operator on macOS/Linux)
# MINDLOOM_OPERATOR_ROOT=

# Optional source session root overrides for multi-agent discovery
# AGENT_MEMORY_CODEX_HOME=
# AGENT_MEMORY_ANTIGRAVITY_BRAIN_DIR=
# AGENT_MEMORY_DSH_HOME=
